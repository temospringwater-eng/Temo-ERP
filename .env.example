# Copy to .env locally or configure equivalent private deployment secrets.
# Never commit actual credentials.
NODE_ENV=production
PORT=3000
# DB_PATH=/private/persistent/path/temo.db
TEMO_BOOTSTRAP_SUPERADMIN_PASSWORD=
TEMO_BOOTSTRAP_COMPANY_ADMIN_PASSWORD=

# Isolated QA host ONLY. Do not use with a real ERP DB or open public firewall.
# Set these via the secret manager on a private host; never commit passwords.
# NODE_ENV=test
# TEMO_ERP_HOSTED_QA=1
# DB_PATH=/private/persistent/temo-erp-qa.db
# Hosted QA binds to 127.0.0.1 and requires both strong bootstrap passwords above.
